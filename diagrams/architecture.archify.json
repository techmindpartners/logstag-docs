  "cards": [
    {
      "dot": "cyan",
      "title": "Connections",
      "items": [
        "The agent opens every connection: to database targets and outbound HTTPS to Logstag",
        "Logstag needs no inbound access to the customer network",
        "Queued commands, such as connection tests, are pulled by the agent"
      ]
    },
    {
      "dot": "emerald",
      "title": "Collected Data",
      "items": [
        "Operational metadata and database statistics",
        "Logstag does not read or copy application table rows",
        "Runtime signals as often as every 10 seconds by default"
      ]
    },
    {
      "dot": "amber",
      "title": "Managed Targets",
      "items": [
        "System metrics for managed databases come from the cloud provider API",
